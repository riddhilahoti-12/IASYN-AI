# IASYN AI Backend Environment Configuration

# Project & Environment
PROJECT_NAME="IASYN AI Clinical Backend"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
# In production, generate a secure 256-bit random key: openssl rand -hex 32
SECRET_KEY="iasyn-ai-dev-clinical-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./iasyn_dev.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql+psycopg2://iasyn_user:secure_password@localhost:5432/iasyn_db"

# CORS Configuration
# Comma-separated allowed origins:
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Initial Demo Credentials (Used only during initial seed if configured)
SEED_PATIENT_EMAIL="patient.demo@iasyn.ai"
SEED_DOCTOR_EMAIL="doctor.demo@iasyn.ai"
SEED_ADMIN_EMAIL="admin.demo@iasyn.ai"
SEED_DEFAULT_PASSWORD="ClinicalPass2026!"
